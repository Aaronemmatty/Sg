ENV=development
SERVICE_NAME=ai_analyst_service
PORT=8012

DATABASE_URL=postgresql://sg_user:sg_password@postgres:5432/sg_db
REDIS_URL=redis://redis:6379/0

AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=auth_service

MARKET_DATA_SERVICE_URL=http://market_data_service:8002
RISK_ENGINE_SERVICE_URL=http://risk_engine_service:8007
EXECUTION_ENGINE_SERVICE_URL=http://execution_engine_service:8008
PORTFOLIO_MANAGEMENT_SERVICE_URL=http://portfolio_management_service:8009

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
HTTP_CLIENT_TIMEOUT_SECONDS=15

# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_VERSION=2023-06-01
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS_DEFAULT=300
CACHE_TTL_SECONDS_MARKET_SUMMARY=120
CACHE_TTL_SECONDS_PORTFOLIO_REVIEW=180

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Security
MAX_CONTEXT_CHARS=12000
MAX_USER_NOTE_CHARS=500
