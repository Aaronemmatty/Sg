# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Security — generate with:
#   openssl rand -hex 64                           (SECRET_KEY)
#   openssl genrsa -out private.pem 4096           (JWT_PRIVATE_KEY)
#   openssl rsa -in private.pem -pubout -out pub.pem (JWT_PUBLIC_KEY)
SECRET_KEY=replace_with_64_byte_hex_secret
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@localhost:6379/0
REDIS_PASSWORD=redispass

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.replace_me
EMAIL_FROM=noreply@sg-trading.local
EMAIL_FROM_NAME=SG Trading Platform

# ── Feature flags ─────────────────────────────────────────────────────────────
MFA_REQUIRED=false
EMAIL_VERIFICATION_REQUIRED=false
DEVICE_TRACKING_ENABLED=true
PROMETHEUS_ENABLED=true

# ── OAuth2 (optional) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/v1/auth/oauth/google/callback
