ENV=development
SERVICE_NAME=backtesting_engine_service
PORT=8010

DATABASE_URL=postgresql://sg_user:sg_password@postgres:5432/sg_db
REDIS_URL=redis://redis:6379/0

AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=auth_service

MARKET_DATA_SERVICE_URL=http://market_data_service:8002
STRATEGY_SERVICE_URL=http://strategy_service:8004
PORTFOLIO_MANAGEMENT_SERVICE_URL=http://portfolio_management_service:8009

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

MAX_CONCURRENT_BACKTESTS=3
BACKTEST_JOB_TTL_DAYS=90
DEFAULT_INITIAL_CAPITAL_INR=1000000
DEFAULT_COMMISSION_BPS=3
DEFAULT_SLIPPAGE_BPS=5
BENCHMARK_SYMBOL=NIFTY50
MONTE_CARLO_DEFAULT_ITERATIONS=2000

HTTP_CLIENT_TIMEOUT_SECONDS=15
