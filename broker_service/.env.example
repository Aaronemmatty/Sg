# ── Broker mode ───────────────────────────────────────────────────────────────
# "paper" = simulated (safe default), "live" = real Kite orders
BROKER_MODE=paper

# ── Kite Connect (only needed when BROKER_MODE=live) ──────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_daily_access_token

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_ORDER_VALUE_INR=500000
MAX_POSITION_VALUE_INR=2000000
MAX_DAILY_LOSS_INR=50000
MAX_ORDERS_PER_SYMBOL_PER_DAY=50

# ── Paper broker ──────────────────────────────────────────────────────────────
PAPER_INITIAL_CAPITAL_INR=1000000
PAPER_SLIPPAGE_PCT=0.05
PAPER_FILL_DELAY_MS=100

# ── Database + Redis ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_platform
REDIS_URL=redis://localhost:6379/2

# ── Market data service (for paper fill prices) ───────────────────────────────
MARKET_DATA_SERVICE_URL=http://market-data:8002

# ── Circuit breaker ───────────────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_S=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
ALLOWED_ORIGINS=http://localhost
