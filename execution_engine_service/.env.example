ENV=development                      # development | staging | production

# Service
SERVICE_PORT=8008
SERVICE_NAME=execution_engine_service

# Postgres (sg_db)
DATABASE_URL=postgresql://sg_user:sg_pass@localhost:5432/sg_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RISK_APPROVED_PATTERN=sg:risk_approved:*
REDIS_EXECUTION_CHANNEL_PREFIX=sg:executions          # publishes sg:executions:{symbol}
REDIS_EXECUTION_EVENTS_CHANNEL=sg:execution:events    # general bus, SSE dashboard (non order-flow-critical)

# auth_service (8001) JWT verification — same pattern as risk_engine (8007)
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/auth_jwt_public_key.pem
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=auth_service

# broker_service (8003) — CONFIRM real endpoint shapes before going live (see clients.py header)
BROKER_SERVICE_BASE_URL=http://localhost:8003
BROKER_SERVICE_TIMEOUT_SECONDS=5.0
BROKER_CALL_MAX_RETRIES=3
BROKER_CALL_BACKOFF_BASE_SECONDS=0.5

# Order routing / smart execution
DEFAULT_EXECUTION_STYLE=AGGRESSIVE           # AGGRESSIVE | PASSIVE
PASSIVE_LIMIT_BAND_BPS=15                    # limit price band for PASSIVE style
ORDER_VALIDITY=DAY                           # DAY | IOC

# Post-submit polling (until broker webhook contract is confirmed)
POST_SUBMIT_POLL_INTERVAL_SECONDS=2
POST_SUBMIT_POLL_TIMEOUT_SECONDS=60

# Reconciliation safety-net sweep (catches anything post-submit polling missed)
RECONCILIATION_INTERVAL_SECONDS=30

# RISK_HOLD handling (OPEN ITEM - see README "Open Decisions")
HOLD_SWEEP_INTERVAL_SECONDS=15
HOLD_MAX_AGE_SECONDS=900                     # 15 min default TTL before a HELD intent is marked EXPIRED

# Idempotency
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
