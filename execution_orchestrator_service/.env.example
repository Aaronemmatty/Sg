# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8006

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sg_user:sg_pass@localhost:5432/sg_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Portfolio ─────────────────────────────────────────────────────────────────
# UUID of the portfolio this orchestrator manages.
# Leave empty to use broker_service default.
DEFAULT_PORTFOLIO_ID=

# ── Downstream service URLs ───────────────────────────────────────────────────
BROKER_SERVICE_URL=http://broker-service:8003
RISK_ENGINE_URL=http://risk-engine:8007

# ── Eligibility thresholds ────────────────────────────────────────────────────
MIN_CONFIDENCE=0.60
MIN_LIQUIDITY_VALUE_INR=100000.0

# ── Position / exposure limits ────────────────────────────────────────────────
MAX_POSITION_PCT=0.10
MAX_SECTOR_EXPOSURE_PCT=0.30
MAX_CORRELATION_SCORE=0.80

# ── Capital allocation ────────────────────────────────────────────────────────
DEFAULT_RISK_PCT=1.0
MAX_ALLOCATION_INR=500000.0
MIN_ALLOCATION_INR=1000.0

# ── Daily loss / drawdown guards ──────────────────────────────────────────────
DAILY_LOSS_LIMIT_INR=50000.0
DAILY_LOSS_LIMIT_PCT=0.05
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
MAX_OPEN_INTENTS=20

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
ALLOWED_ORIGINS=http://localhost
# Set to your OTLP collector endpoint, e.g. http://otel-collector:4317
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=execution-orchestrator
AUDIT_LOG_ENABLED=true
