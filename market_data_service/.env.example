# ── Kite Connect ──────────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_daily_access_token  # rotate daily via Kite login

# Feed mode: "live" = real KiteTicker, "mock" = synthetic GBM feed
KITE_MODE=mock

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_platform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Yahoo Finance ─────────────────────────────────────────────────────────────
YAHOO_ENABLED=true

# ── ClickHouse (optional raw tick archive) ────────────────────────────────────
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=sg_ticks
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Data quality ──────────────────────────────────────────────────────────────
MAX_PRICE_DEVIATION_PCT=20.0
MIN_VALID_PRICE=0.05

# ── Retention ─────────────────────────────────────────────────────────────────
TICK_RETENTION_DAYS=365
DAILY_RETENTION_YEARS=10

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
ALLOWED_ORIGINS=http://localhost
POSTGRES_PASSWORD=change_me
