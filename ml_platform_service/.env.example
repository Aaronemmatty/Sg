# ── ML Platform Service (8011) ───────────────────────────────────────────────
ENV=development
SERVICE_PORT=8011
SERVICE_NAME=ml_platform_service

# PostgreSQL — shared sg_db
DATABASE_URL=postgresql://sg_user:sg_pass@localhost:5432/sg_db
DB_POOL_MIN_SIZE=3
DB_POOL_MAX_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Inbound: candle data for feature computation
REDIS_CANDLE_PATTERN=sg:market:candle:*

# Outbound channels
REDIS_ML_SIGNALS_CHANNEL_PREFIX=sg:ml:signals
REDIS_ML_REGIME_CHANNEL_PREFIX=sg:ml:regime

# Upstream services
MARKET_DATA_SERVICE_URL=http://market_data_service:8002
PORTFOLIO_MANAGEMENT_SERVICE_URL=http://portfolio_management_service:8009

# Auth
AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=auth_service

# Feature store
FEATURE_LOOKBACK_BARS=500       # bars to fetch for feature computation
FEATURE_CACHE_TTL_SECONDS=30    # how long to cache computed features in Redis

# Training
TRAIN_SCHEDULE_CRON=0 18 * * 1-5   # retrain weekdays at 18:00 (after market)
TRAIN_MIN_SAMPLES=1000              # min bars needed to trigger training
TRAIN_TEST_SPLIT=0.2
TRAIN_VALIDATION_SPLIT=0.1

# Serving
PREDICTION_CACHE_TTL_SECONDS=60    # cache model predictions in Redis
SERVING_CONFIDENCE_THRESHOLD=0.55  # min confidence to publish a signal

# Model registry
MODEL_ARTIFACTS_PATH=/var/ml_platform/models
MODEL_CHAMPION_AUTO_PROMOTE=true   # auto-promote if challenger beats champion

# Experiment tracking (MLflow — SQLite backend, no server needed)
MLFLOW_TRACKING_URI=sqlite:///var/ml_platform/mlflow.db
MLFLOW_EXPERIMENT_NAME=sg_trading

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
