# Copy to .env and fill in before `docker compose up`

# --- Telegram alerting (alertmanager-bot) ---
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
# To get a chat id: message your bot, then GET
# https://api.telegram.org/bot<token>/getUpdates

# --- Postgres exporter (points at the existing sg_db) ---
DATA_SOURCE_NAME=postgresql://sg_readonly:replace-me@localhost:5432/sg_db?sslmode=disable

# --- Redis exporter ---
REDIS_ADDR=redis://localhost:6379

# --- Retention (personal deployment defaults — adjust for real prod) ---
PROMETHEUS_RETENTION=30d
LOKI_RETENTION_HOURS=720
