{
  "title": "Trading Pipeline — Signal to Fill to P&L",
  "uid": "sg-trading-pipeline",
  "tags": ["sg-platform", "domain", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Risk Kill Switch",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(risk_engine_kill_switch_state{state=~\"HALTED_.*|EMERGENCY_STOP\"}) > 0", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLEAR", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "ACTIVE", "color": "red" } } }
          ]
        }
      },
      "options": { "colorMode": "background", "textMode": "value" }
    },
    {
      "id": 2,
      "title": "Circuit Breakers Tripped",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(risk_engine_circuit_breaker_tripped)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value" }
    },
    {
      "id": 3,
      "title": "Execution Placement Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(execution_orders_placed_total[5m]))", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Pipeline Throughput — eval / received / filled",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(risk_engine_intents_evaluated_total[5m]))", "legendFormat": "risk intents evaluated", "refId": "A" },
        { "expr": "sum(rate(execution_orders_received_total[5m]))", "legendFormat": "orders received", "refId": "B" },
        { "expr": "sum(rate(execution_orders_placed_total[5m]))", "legendFormat": "orders placed", "refId": "C" },
        { "expr": "sum(rate(execution_orders_terminal_total{state=~\"FILLED|REJECTED|FAILED\"}[5m]))", "legendFormat": "terminal orders", "refId": "D" }
      ]
    },
    {
      "id": 5,
      "title": "Slippage (bps) — p50/p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(execution_slippage_bps_bucket[15m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(execution_slippage_bps_bucket[15m])))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "Order Outcomes (15m, stacked)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (state) (increase(execution_orders_terminal_total[15m]))", "legendFormat": "{{state}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "ML Signal Publish Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(ml_signals_published_total[5m]))", "refId": "A" }]
    }
  ]
}
