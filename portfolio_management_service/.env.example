# ── Portfolio Management Service (8009) ─────────────────────────────────────
ENV=development
SERVICE_PORT=8009
SERVICE_NAME=portfolio_management_service

# PostgreSQL — same sg_db as all other services
DATABASE_URL=postgresql://sg_user:sg_pass@localhost:5432/sg_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Inbound Redis channels (published by execution_engine_service / 8008)
REDIS_EXECUTIONS_PATTERN=sg:executions:*
REDIS_EXECUTION_EVENTS_CHANNEL=sg:execution:events

# Outbound Redis channel (portfolio state for downstream / dashboards)
REDIS_PORTFOLIO_EVENTS_CHANNEL=sg:portfolio:events

# Auth (RS256 public key from auth_service / 8001)
AUTH_JWT_PUBLIC_KEY_PATH=
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=auth_service

# Upstream service URLs
MARKET_DATA_SERVICE_URL=http://market_data_service:8002

# Mark-to-market background refresh
MTM_REFRESH_INTERVAL_SECONDS=5
MTM_MARKET_HOURS_ONLY=true

# Snapshot persistence: how often to write a PortfolioSnapshot row
SNAPSHOT_INTERVAL_SECONDS=60

# Benchmark (NIFTY 50 symbol as carried by market_data_service)
BENCHMARK_SYMBOL=NIFTY50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
