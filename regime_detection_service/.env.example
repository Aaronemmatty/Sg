SERVICE_NAME=regime_detection_service
SERVICE_PORT=8005
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_db
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

REDIS_URL=redis://localhost:6379/0

MARKET_DATA_SERVICE_URL=http://localhost:8002
PRIMARY_SYMBOL=NIFTY50
PRIMARY_EXCHANGE=NSE
DEFAULT_TIMEFRAME=5m
WATCHLIST_SYMBOLS=RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,TATAMOTORS,SBIN,ITC,LT,AXISBANK
VIX_SYMBOL=INDIAVIX

REGIME_MODEL_PATH=models/regime_classifier.joblib
CLASSIFIER_TYPE=random_forest
MIN_CONFIDENCE_FOR_TRANSITION=0.55
PER_SYMBOL_DIVERGENCE_THRESHOLD=0.6

RECALC_INTERVAL_SECONDS=300
TRANSITION_CONFIRM_BARS=2

JWT_PUBLIC_KEY_PATH=/run/secrets/auth_public_key.pem
AUTH_REQUIRED=true
