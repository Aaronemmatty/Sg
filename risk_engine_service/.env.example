# risk_engine_service (port 8007)

SERVICE_NAME=risk_engine_service
SERVICE_PORT=8007
ENV=production

# Postgres
POSTGRES_DSN=postgresql://sg_user:sg_pass@localhost:5432/sg_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Upstream services
BROKER_SERVICE_URL=http://broker_service:8003
MARKET_DATA_SERVICE_URL=http://market_data_service:8002
EXECUTION_ORCHESTRATOR_URL=http://execution_orchestrator_service:8006
AUTH_SERVICE_URL=http://auth_service:8001
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=risk_engine_service

# Risk engine behavior
MARGIN_CHECK_MODE=resilient        # resilient | strict | disabled
MARGIN_CACHE_TTL_SECONDS=30
VAR_METHOD=parametric              # parametric | historical
VAR_CONFIDENCE=0.95
VAR_HORIZON_DAYS=1
KILL_SWITCH_AUTO_RESET_REQUIRES_ROLE=risk_officer
