# SG Trading Platform — Frontend Environment
# Copy to .env.local for local dev

# Service URLs (server-side only — BFF pattern)
AUTH_SERVICE_URL=http://auth_service:8001
MARKET_DATA_SERVICE_URL=http://market_data_service:8002
BROKER_SERVICE_URL=http://broker_service:8003
STRATEGY_SERVICE_URL=http://strategy_service:8004
REGIME_SERVICE_URL=http://regime_detection_service:8005
ORCHESTRATOR_SERVICE_URL=http://execution_orchestrator_service:8006
RISK_ENGINE_URL=http://risk_engine_service:8007
EXECUTION_ENGINE_URL=http://execution_engine_service:8008
PORTFOLIO_SERVICE_URL=http://portfolio_management_service:8009
BACKTESTING_SERVICE_URL=http://backtesting_engine:8010
ML_PLATFORM_URL=http://ml_platform_service:8011
AI_ANALYST_URL=http://ai_analyst_service:8012

# JWT — must match auth_service RS256 public key
# Leave empty to auto-fetch from auth_service /api/v1/auth/public-key
JWT_PUBLIC_KEY=

# Session cookie secret (min 32 chars)
SESSION_SECRET=change_this_to_a_random_32_char_secret_in_production

# Public env (exposed to browser)
NEXT_PUBLIC_APP_NAME="SG Trading"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SSE_BASE_URL=http://localhost
