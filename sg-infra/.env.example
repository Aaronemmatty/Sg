# ═══════════════════════════════════════════════════════════════════
# SG Trading Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# SETUP:
#   cp .env.example .env
#   Fill in every value marked REQUIRED
#   Never commit .env to git — it is in .gitignore
#
# GENERATE SECRETS:
#   python scripts/generate_secrets.py
# ═══════════════════════════════════════════════════════════════════

# ─── Deployment ──────────────────────────────────────────────────
SERVICE_ENV=production
VERSION=latest

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=sg_db
POSTGRES_USER=sg_user
POSTGRES_PASSWORD=REQUIRED_change_me_32chars_minimum   # REQUIRED

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=REQUIRED_change_me_32chars_minimum      # REQUIRED

# ─── JWT (RS256) ─────────────────────────────────────────────────
# Generate with: python scripts/generate_secrets.py --jwt
# Private key — only auth_service needs this
JWT_PRIVATE_KEY=                                        # REQUIRED — multi-line, use \n
# Public key — all services verify tokens with this
JWT_PUBLIC_KEY=                                         # REQUIRED — multi-line, use \n

# ─── Kite / Zerodha ──────────────────────────────────────────────
KITE_API_KEY=                                           # REQUIRED for live trading
KITE_API_SECRET=                                        # REQUIRED for live trading
KITE_ACCESS_TOKEN=                                      # Refreshed daily via kite_token.sh

# ─── LLM APIs (ai_analyst_service) ───────────────────────────────
ANTHROPIC_API_KEY=                                      # OPTIONAL — ai_analyst_service starts without it; AI analysis endpoints return 503 until set
OPENAI_API_KEY=                                         # Optional fallback

# ─── Dashboard ───────────────────────────────────────────────────
SESSION_SECRET=REQUIRED_change_me_32chars_minimum       # REQUIRED — httpOnly cookie signing

# ─── Observability ───────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=REQUIRED_change_me                     # REQUIRED
TELEGRAM_BOT_TOKEN=                                     # Alertmanager → Telegram bridge
TELEGRAM_CHAT_ID=                                       # Message your bot, then GET getUpdates

# ─── OTel (optional — leave blank to disable tracing) ────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sg_trading

# ─── MLflow ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
