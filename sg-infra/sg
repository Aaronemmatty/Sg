#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# SG Trading Platform — Management Script
# ═══════════════════════════════════════════════════════════════════
# Usage:
#   ./sg up              # start entire platform (bootstraps sg_network)
#   ./sg down             # stop (data preserved)
#   ./sg restart         # full restart
#   ./sg logs [service]  # tail logs
#   ./sg ps              # container status
#   ./sg health          # health check all services
#   ./sg migrate         # run shared core-schema migration (one-shot)
#   ./sg backup          # run backup
#   ./sg deploy          # blue-green deploy (app tier only — see scripts/)
#   ./sg shell <service> # exec into container
#   ./sg db              # open psql shell
#   ./sg redis           # open redis-cli shell
#   ./sg pull            # git pull + rebuild changed services + deploy
#   ./sg secrets         # generate/rotate secrets
#   ./sg status          # show deployment slot status
#
# Default project is sg_blue — this is the "primary" project that owns the
# singleton infra (postgres/redis/mlflow/observability/nginx) the first
# time you run `./sg up`. Blue/green deploys via `./sg deploy` only ever
# touch the 13 platform services + dashboard (see scripts/
# blue_green_deploy.sh) — infra is never duplicated under sg_green.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE="docker compose -p sg_blue -f $SCRIPT_DIR/docker/docker-compose.yml --env-file $SCRIPT_DIR/.env"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; NC='\033[0m'; BOLD='\033[1m'

ensure_network() {
    if ! docker network inspect sg_network &>/dev/null; then
        echo -e "${CYAN}Creating shared network sg_network...${NC}"
        docker network create sg_network >/dev/null
    fi
}

ensure_env() {
    if [[ ! -f "$SCRIPT_DIR/.env" ]]; then
        echo -e "${RED}No .env found.${NC} Run ${BOLD}./sg secrets${NC} first (it bootstraps .env from .env.example and fills in random secrets), then add KITE_*/ANTHROPIC_API_KEY manually."
        exit 1
    fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in

    up)
        ensure_env
        ensure_network
        # shellcheck disable=SC1091
        source "$SCRIPT_DIR/.env"
        echo -e "${GREEN}${BOLD}Starting SG Trading Platform...${NC}"
        echo -e "${CYAN}Bootstrapping infrastructure (postgres, redis)...${NC}"
        $COMPOSE up -d postgres redis
        echo -e "${CYAN}Waiting for PostgreSQL to become ready...${NC}"
        for _ in $(seq 1 30); do
            if docker exec sg_postgres pg_isready -U "${POSTGRES_USER:-sg_user}" -d "${POSTGRES_DB:-sg_db}" &>/dev/null; then
                break
            fi
            sleep 2
        done
        echo -e "${CYAN}Running shared core-schema migration...${NC}"
        $COMPOSE --profile migrate run --rm migrate
        echo -e "${CYAN}Starting all platform services...${NC}"
        $COMPOSE up -d --build "$@"
        sleep 3
        bash "$SCRIPT_DIR/scripts/health_check.sh" || true
        echo -e "\n${GREEN}Dashboard: http://localhost${NC}"
        echo -e "${CYAN}Grafana:   http://localhost:3001  (or http://localhost/grafana)${NC}"
        echo -e "${CYAN}MLflow:    http://localhost/mlflow  (or http://127.0.0.1:5000)${NC}"
        echo -e "${CYAN}Prometheus: http://127.0.0.1:9090${NC}"
        ;;

    down)
        echo -e "${YELLOW}Stopping SG Trading Platform...${NC}"
        $COMPOSE down --remove-orphans "$@"
        echo -e "${GREEN}Platform stopped (data preserved)${NC}"
        ;;

    restart)
        bash "$0" down
        sleep 2
        bash "$0" up
        ;;

    logs)
        if [[ -n "${1:-}" ]]; then
            $COMPOSE logs -f --tail=100 "$1"
        else
            $COMPOSE logs -f --tail=50
        fi
        ;;

    ps)
        $COMPOSE ps
        ;;

    health)
        bash "$SCRIPT_DIR/scripts/health_check.sh" "$@"
        ;;

    migrate)
        echo -e "${CYAN}Running shared core-schema migration (database/ package)...${NC}"
        $COMPOSE --profile migrate run --rm migrate
        echo -e "${YELLOW}Note: this covers shared core tables only. Several services ship their"
        echo -e "own migrations (alembic or raw SQL) — see docs/DEPLOYMENT_NOTES.md"
        echo -e "'Migrations' for the full per-service status before going live.${NC}"
        ;;

    backup)
        bash "$SCRIPT_DIR/scripts/backup.sh" "$@"
        ;;

    deploy)
        bash "$SCRIPT_DIR/scripts/blue_green_deploy.sh" "$@"
        ;;

    shell)
        [[ -n "${1:-}" ]] || { echo "Usage: ./sg shell <service>"; exit 1; }
        $COMPOSE exec "$1" /bin/bash 2>/dev/null || $COMPOSE exec "$1" /bin/sh
        ;;

    db)
        source "$SCRIPT_DIR/.env"
        docker exec -it sg_postgres psql -U "${POSTGRES_USER:-sg_user}" -d "${POSTGRES_DB:-sg_db}"
        ;;

    redis)
        source "$SCRIPT_DIR/.env"
        docker exec -it sg_redis redis-cli -a "${REDIS_PASSWORD:-}" --no-auth-warning
        ;;

    build)
        echo -e "${CYAN}Building all images...${NC}"
        $COMPOSE build --parallel "$@"
        echo -e "${GREEN}Build complete${NC}"
        ;;

    pull)
        echo -e "${CYAN}Pulling latest code...${NC}"
        git -C "$SCRIPT_DIR" pull --rebase
        echo -e "${CYAN}Deploying changed services (blue-green, app tier only)...${NC}"
        bash "$SCRIPT_DIR/scripts/blue_green_deploy.sh"
        ;;

    secrets)
        # Default to --patch-env so secrets are written directly into .env.
        # Pass --help or explicit flags to override.
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
            python3 "$SCRIPT_DIR/scripts/generate_secrets.py" --help
        elif [[ $# -gt 0 ]]; then
            python3 "$SCRIPT_DIR/scripts/generate_secrets.py" "$@"
        else
            python3 "$SCRIPT_DIR/scripts/generate_secrets.py" --patch-env
        fi
        echo -e "${YELLOW}Optional: add KITE_API_KEY, KITE_API_SECRET, ANTHROPIC_API_KEY to $SCRIPT_DIR/.env${NC}"
        echo -e "${DIM}The platform runs without them — AI analysis and live broker endpoints return 503 until set.${NC}"
        ;;

    status)
        bash "$SCRIPT_DIR/scripts/blue_green_deploy.sh" --status
        ;;

    help|--help|-h|*)
        echo ""
        echo -e "${BOLD}SG Trading Platform${NC}"
        echo ""
        echo "  ./sg up              Start entire platform"
        echo "  ./sg down            Stop platform (data preserved)"
        echo "  ./sg restart         Full restart"
        echo "  ./sg logs [service]  Tail logs (all or one service)"
        echo "  ./sg ps              Container status"
        echo "  ./sg health          Health check all 14 services (13 platform + dashboard)"
        echo "  ./sg migrate         Run shared core-schema migration (one-shot)"
        echo "  ./sg backup          Run full backup"
        echo "  ./sg deploy          Blue-green deploy (app tier only)"
        echo "  ./sg shell <svc>     Exec shell in container"
        echo "  ./sg db              Open PostgreSQL shell"
        echo "  ./sg redis           Open Redis CLI"
        echo "  ./sg build           Build all Docker images"
        echo "  ./sg pull            Git pull + rebuild + deploy"
        echo "  ./sg secrets         Generate/rotate secrets"
        echo "  ./sg status          Show deployment slot status"
        echo ""
        ;;
esac
