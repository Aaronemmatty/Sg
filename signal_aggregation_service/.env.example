SERVICE_NAME=signal_aggregation_service
SERVICE_PORT=8006
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_db
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

REDIS_URL=redis://localhost:6379/0

DEFAULT_TIMEFRAME=5m
PRIMARY_SYMBOL=NIFTY50
WATCHLIST_SYMBOLS=RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,TATAMOTORS,SBIN,ITC,LT,AXISBANK
STRATEGY_REGISTRY=trend_following,mean_reversion,breakout,momentum,ml_prediction,rsi

BUY_THRESHOLD=0.20
SELL_THRESHOLD=-0.20
MIN_STRATEGIES_REQUIRED=2
MIN_INDIVIDUAL_CONFIDENCE_FOR_CONTRIBUTOR=0.50
SIGNAL_STALENESS_SECONDS=900
DEFAULT_UNMAPPED_STRATEGY_WEIGHT=0.05
AGREEMENT_DAMPENING_FLOOR=0.5

RECALC_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=600
WEIGHT_CACHE_TTL_SECONDS=60

JWT_PUBLIC_KEY_PATH=/run/secrets/auth_public_key.pem
AUTH_REQUIRED=true
