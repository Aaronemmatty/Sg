# ── Trading mode ──────────────────────────────────────────────────────────────
# "paper" = simulated (safe default), "live" = live signals, "backtest" = replay
TRADING_MODE=paper

# ── Strategy paths ────────────────────────────────────────────────────────────
USER_STRATEGIES_DIR=/app/strategies
MAX_STRATEGY_FILE_SIZE=524288   # 512KB

# ── Execution sandbox ─────────────────────────────────────────────────────────
STRATEGY_EXECUTION_TIMEOUT_S=5.0
STRATEGY_MAX_RESTARTS=5
STRATEGY_RESTART_BACKOFF_S=10.0

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sg:sg@localhost:5432/sg_platform
REDIS_URL=redis://localhost:6379/3

# ── Market data service ───────────────────────────────────────────────────────
MARKET_DATA_SERVICE_URL=http://market-data:8002
REDIS_MARKET_CHANNEL_PREFIX=sg:market

# ── Signal publishing ─────────────────────────────────────────────────────────
REDIS_SIGNAL_CHANNEL_PREFIX=sg:signals
SIGNAL_EXPIRY_S=300

# ── Market hours (IST) ────────────────────────────────────────────────────────
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
ALLOWED_ORIGINS=http://localhost
POSTGRES_PASSWORD=change_me
